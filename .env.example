# Copy to .env.local and fill in from Supabase → Project Settings → API keys / Database.
# Never commit .env.local. Never prefix server secrets with NEXT_PUBLIC_.

# Public values (safe in the browser because RLS is enforced)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server only
SUPABASE_SECRET_KEY=sb_secret_xxx
# Postgres connection string used by `pnpm db:push` (Supabase → Connect → Session pooler)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# Public site URL used in invitation / password-reset links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Defaults for a new organisation (overridable in Settings)
DEFAULT_ORGANIZATION_TIMEZONE=Asia/Tehran
